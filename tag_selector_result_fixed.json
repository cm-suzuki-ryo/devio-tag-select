\u691c\u8a3c\u306eCNAME\u30ec\u30b3\u30fc\u30c9\u3092\u518d\u767b\u9332\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\u300d | \u300c\u5225AWS\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u518d\u767a\u884c\u3057\u306a\u3044\u9650\u308a\u3001DNS\u691c\u8a3c\u7528CNAME\u30ec\u30b3\u30fc\u30c9\u306e\u518d\u767b\u9332\u306f\u4e0d\u8981\u300d | \u300c\u3092\u518d\u767b\u9332\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\u300d\u3092\u300c\u306e\u518d\u767b\u9332\u306f\u4e0d\u8981\u300d\u306b\u7d71\u4e00 |\n| \u300cACM\u3067\u767a\u884c\u3059\u308b\u8a3c\u660e\u66f8\u306e\u30ad\u30fc\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3084\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u306e\u8a31\u53ef\u3092\u5909\u66f4\u3057\u305f\u5834\u5408\u306bDNS\u691c\u8a3c\u306eCNAME\u30ec\u30b3\u30fc\u30c9\u304c\u5909\u308f\u308b\u304b\u78ba\u8a8d\u3057\u3066\u307f\u307e\u3057\u305f\u3002\u300d | \u300cACM\u3067\u767a\u884c\u3057\u305f\u8a3c\u660e\u66f8\u306e\u30ad\u30fc\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3084\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u8a2d\u5b9a\u3092\u5909\u66f4\u3057\u305f\u5834\u5408\u3001DNS\u691c\u8a3c\u7528CNAME\u30ec\u30b3\u30fc\u30c9\u304c\u5909\u308f\u308b\u304b\u3092\u691c\u8a3c\u3057\u307e\u3057\u305f\u3002\u300d | \u7528\u8a9e\u3092\u7d71\u4e00\u3001\u300c\u78ba\u8a8d\u3057\u3066\u307f\u307e\u3057\u305f\u300d\u3092\u300c\u691c\u8a3c\u3057\u307e\u3057\u305f\u300d\u306b |\n| \u300c\u7d50\u8ad6\u3001\u5225AWS\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u518d\u767a\u884c\u3057\u306a\u3044\u9650\u308aDNS\u691c\u8a3c\u306eCNAME\u30ec\u30b3\u30fc\u30c9\u3092\u518d\u767b\u9332\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\u3067\u3059\u3002\u300d | \u300c\u7d50\u8ad6\u3068\u3057\u3066\u3001\u5225AWS\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u518d\u767a\u884c\u3057\u306a\u3044\u9650\u308a\u3001DNS\u691c\u8a3c\u7528CNAME\u30ec\u30b3\u30fc\u30c9\u306e\u518d\u767b\u9332\u306f\u4e0d\u8981\u3067\u3059\u3002\u300d | \u300c\u7d50\u8ad6\u3001\u300d\u3092\u300c\u7d50\u8ad6\u3068\u3057\u3066\u3001\u300d\u306b\u3001\u300c\u5fc5\u8981\u