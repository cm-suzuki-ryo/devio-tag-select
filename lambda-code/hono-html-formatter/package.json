{
  "name": "hono-html-formatter",
  "version": "1.0.0",
  "description": "Hono-based Lambda function for formatting article analysis results to HTML",
  "main": "index.js",
  "scripts": {
    "build": "esbuild index.ts --bundle --minify --outfile=dist/index.js --platform=node --target=node18",
    "deploy": "zip -r function.zip dist/",
    "dev": "tsx watch index.ts"
  },
  "dependencies": {
    "hono": "^3.12.0",
    "@hono/node-server": "^1.8.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "esbuild": "^0.19.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
