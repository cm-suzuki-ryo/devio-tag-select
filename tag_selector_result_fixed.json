u30e7\u30f3\u306f\u8907\u96d1\u3067\u3001\u4ee5\u4e0b\u306e3\u3064\u306e\u7570\u306a\u308b\u73fe\u8c61\u304c\u6df7\u5728\u3057\u3066\u3044\u307e\u3059\uff1a\n- AWS CLI\u306e\u51aa\u7b49\u6027\u52d5\u4f5c\n- \u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u30b3\u30f3\u30bd\u30fc\u30eb\u3068\u306e\u52d5\u4f5c\u5dee\u7570\n- \u51aa\u7b49\u6027\u30c8\u30fc\u30af\u30f3\u306e\u6709\u52b9\u671f\u9650\n\n**\u6539\u5584\u6848**\uff1a\n- \u30bb\u30af\u30b7\u30e7\u30f3\u3092\u300cAWS CLI\u306e\u51aa\u7b49\u6027\u52d5\u4f5c\u300d\u306b\u6539\u540d\n- \u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u30b3\u30f3\u30bd\u30fc\u30eb\u3068\u306e\u5dee\u7570\u3092\u660e\u78ba\u306b\u5206\u96e2\n- \u51aa\u7b49\u6027\u30c8\u30fc\u30af\u30f3\u306e\u8aac\u660e\u3092\u5148\u51fa\u3057\u3059\u308b\n\n### 3.3 \u7528\u8a9e\u306e\u7d71\u4e00\n\u8a18\u4e8b\u5168\u4f53\u3067\u4ee5\u4e0b\u3092\u7d71\u4e00\u3057\u3066\u304f\u3060\u3055\u3044\uff1a\n\n| \u73fe\u5728 | \u7d71\u4e00\u6848 |\n|-----|--------|\n| \u300cDNS\u691c\u8a3c\u306eCNAME\u30ec\u30b3\u30fc\u30c9\u300d\u300cDNS\u691c\u8a3c\u306e\u30ec\u30b3\u30fc\u30c9\u60c5\u5831\u300d | \u300cDNS\u691c\u8a3c\u7528CNAME\u30ec\u30b3\u30fc\u30c9\u300d |\n| \u300c\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u306e\u8a31\u53ef\u300d\u300c\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u8a31\u53ef\u306e\u6709\u7121\u300d | \u300c\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u8a2d\u5b9a\u300d |\n| \u300c\u78ba\u8a8d\u3057\u3066\u307f\u305f\u300d\u300c\u5206\u304b\u308a\u307e\u3057\u305f\u300d | \u300c\u691c\u8a3c\u3057\u307e\u3057\u305f\u300d\u300c\u78ba\u8a8d\u3067\u304d\u307e\u3057\u305f\u300d |\n| \u300c\u3067\u3059\u306d\u300d\u300c\u3067\u3057\u3087\u3046\u304b\u300d | \u524a\u9664\u307e\u305f\u306f\u300c\u3067\u3059\u300d\u306b\u7d71\u4e00 |\n\n---\n\n## 4. \u691c\u8a3c\u306e\u6b63\u78ba\u6027\u306b\u95a2\u3059\u308b\u88dc\u8db3\n\n\u8a18\u4e8b\u306e\u6280\u8853\u7684\u5185\u5bb9\u306f\u6b63\u78ba\u3067\u3059\u304c\u3001\u4ee5\u4e0b\u306e\u70b9\u3092\u88dc\u8db3\u3059\u308b\u3068\u3001\u3088\u308